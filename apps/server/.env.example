# Required: a long random secret shared by all your devices.
# Generate one with:  npx reconnotes-server gen-token   (or: openssl rand -base64 24)
RECON_TOKEN=

# Where the database, attachments and backups live.
RECON_DATA_DIR=./data
RECON_PORT=8787
RECON_HOST=0.0.0.0

# HTTPS (also on a WireGuard / private address): run `node dist/index.js https-setup`
# once, then it's served on this port. Or use your own certificate files.
# RECON_HTTPS_PORT=8443
# RECON_TLS_CERT=/path/to/fullchain.pem
# RECON_TLS_KEY=/path/to/privkey.pem

# Serve the built web app from this server (optional). Use apps/web/dist.
# RECON_WEB_DIR=../web/dist

# --- AI (optional) ---------------------------------------------------------
# AI agents are normally managed in the app (Settings › AI agents).
# The variables below are only read on the very first start, to import an
# existing setup as agents; after that, changes here are ignored.
# Two backends are supported and can be mixed per task:
#   anthropic – Claude via ANTHROPIC_API_KEY (best quality, reads PDFs)
#   ollama    – a local model served by Ollama (private, free to run)

# Local Ollama server, e.g. running `ollama serve` on another machine/VM.
# RECON_OLLAMA_URL=http://ollama-handwriting-to-text:11434
# Vision/OCR model used for handwriting and images:
# RECON_OLLAMA_MODEL=HSR-DeepThink/strike-ocr:latest
# Text model used to compile notes into documents (defaults to RECON_OLLAMA_MODEL);
# a general model such as llama3.1 or qwen3 works better than an OCR model here:
# RECON_OLLAMA_TEXT_MODEL=qwen3:8b
# Replace the built-in handwriting prompt if your OCR model prefers a short one:
# RECON_OLLAMA_HANDWRITING_PROMPT=Transcribe the handwritten text in this image.
# RECON_OLLAMA_TIMEOUT_MS=300000

ANTHROPIC_API_KEY=

# Which backend does what: anthropic | ollama | none.
# Default: anthropic if ANTHROPIC_API_KEY is set, otherwise ollama if RECON_OLLAMA_URL is set.
# RECON_AI_PROVIDER=ollama
# RECON_HANDWRITING_PROVIDER=ollama
# RECON_IMAGE_PROVIDER=ollama
# RECON_COMPILE_PROVIDER=anthropic

# RECON_AI_MODEL=claude-opus-5-5
# RECON_AI_EFFORT=medium
# Automatically recognise handwriting so it is searchable (default: on when a handwriting backend is configured)
# RECON_AUTO_HANDWRITING=true
# Seconds of pen inactivity before a drawing is recognised (milliseconds)
# RECON_HANDWRITING_DEBOUNCE_MS=90000
# Automatically extract text from images and PDFs (default: on when an image backend is configured)
# RECON_AUTO_IMAGE_TEXT=true

# --- Audio transcription (optional) ----------------------------------------
# Any OpenAI-compatible speech-to-text server, e.g. a local whisper server:
# RECON_TRANSCRIBE_URL=http://localhost:8000
# RECON_TRANSCRIBE_MODEL=whisper-1
# RECON_TRANSCRIBE_API_KEY=

# --- Backups ----------------------------------------------------------------
# RECON_BACKUP_DIR=./data/backups
# RECON_BACKUP_INTERVAL_HOURS=24
# RECON_BACKUP_KEEP=14
# RECON_MAX_UPLOAD_MB=200
