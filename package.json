{
  "name": "reconnotes",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first notes for iPhone, iPad and the web, with a self-hosted Linux sync server.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @reconnotes/server",
    "dev:web": "npm run dev -w @reconnotes/web",
    "build": "npm run build -w @reconnotes/web && npm run build -w @reconnotes/server",
    "test": "npm test -w @reconnotes/core && npm test -w @reconnotes/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
